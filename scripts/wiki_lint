#!/usr/bin/env python3
"""Lint the PostgreSQL engine wiki for link, metadata, and source-reference drift."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Iterable

sys.dont_write_bytecode = True

REPO_ROOT = Path(__file__).resolve().parents[1]
WIKI_ROOT = REPO_ROOT / "wiki"
RUNTIME_ROOT = (REPO_ROOT / ".wiki-runtime").resolve()
PROJECT_VENV = RUNTIME_ROOT / "venv"


SECRET_KEY_RE = re.compile(r"(token|password|secret|api[_-]?key|authorization|bearer)", re.IGNORECASE)
SECRET_VALUE_RE = re.compile(
    r"(sk-[A-Za-z0-9_-]{8,}|ghp_[A-Za-z0-9_]{8,}|github_pat_[A-Za-z0-9_]{8,}|hf_[A-Za-z0-9_]{8,})"
)


def ensure_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        path.chmod(0o700)
    except OSError:
        pass


def ensure_private_file(path: Path) -> None:
    try:
        path.chmod(0o600)
    except FileNotFoundError:
        pass
    except OSError:
        pass


def append_private_text(path: Path, text: str) -> None:
    ensure_private_dir(path.parent)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as handle:
        handle.write(text)
    ensure_private_file(path)


def redact_arg(arg: str) -> str:
    if "=" in arg:
        key, _ = arg.split("=", 1)
        if SECRET_KEY_RE.search(key):
            return f"{key}=<redacted>"
    if SECRET_VALUE_RE.search(arg):
        return SECRET_VALUE_RE.sub("<redacted>", arg)
    return arg


def redact_args(argv: Iterable[str]) -> list[str]:
    redacted: list[str] = []
    redact_next = False
    for arg in argv:
        if redact_next:
            redacted.append("<redacted>")
            redact_next = False
            continue
        redacted_arg = redact_arg(arg)
        redacted.append(redacted_arg)
        if SECRET_KEY_RE.search(arg.lstrip("-")) and "=" not in arg:
            redact_next = True
    return redacted


def ensure_runtime_dirs() -> None:
    ensure_private_dir(RUNTIME_ROOT)
    for rel in (
        "cache/wiki_lint",
        "logs",
    ):
        ensure_private_dir(RUNTIME_ROOT / rel)


def append_tool_log(tool: str, argv: Iterable[str]) -> None:
    ensure_runtime_dirs()
    log_path = RUNTIME_ROOT / "logs" / f"{tool}.log"
    timestamp = datetime.now().isoformat(timespec="seconds")
    rendered_args = " ".join(redact_args(argv))
    append_private_text(log_path, f"{timestamp} {tool} {rendered_args}\n")


def die(message: str, code: int = 2) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_project_venv() -> None:
    if os.environ.get("WIKI_ALLOW_SYSTEM_PYTHON") == "1":
        return
    # sys.prefix points at the venv root; sys.executable can be a symlink
    # to a system interpreter (e.g. Homebrew on macOS), so don't resolve it.
    prefix = Path(sys.prefix)
    expected = PROJECT_VENV
    in_some_venv = sys.prefix != sys.base_prefix
    if not in_some_venv or prefix != expected:
        venv_rel = expected.relative_to(REPO_ROOT).as_posix()
        die(
            "this script must run inside the project venv "
            f"({venv_rel}). Create it with `python3 -m venv {venv_rel}`, then re-run via "
            f"`{venv_rel}/bin/python scripts/<name>` or after `source {venv_rel}/bin/activate`. "
            "Set WIKI_ALLOW_SYSTEM_PYTHON=1 to bypass (not recommended)."
        )


require_project_venv()


def strip_ticks(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == "`" and value[-1] == "`":
        return value[1:-1]
    return value


def load_versions() -> dict[str, dict[str, str]]:
    versions_path = WIKI_ROOT / "versions.md"
    if not versions_path.exists():
        die("wiki/versions.md does not exist")

    versions: dict[str, dict[str, str]] = {}
    table = _strip_fenced_code(section_text(versions_path.read_text(encoding="utf-8"), "Supported Versions"))
    for line in table.splitlines():
        stripped = line.strip()
        if not stripped.startswith("|"):
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if cells[0] == "Version" or all(re.fullmatch(r":?-+:?", cell) for cell in cells):
            continue
        if len(cells) < 6 or not re.fullmatch(r"[0-9]+", cells[0]):
            die("wiki/versions.md contains a malformed supported-version row")
        version, status, wiki_home, branch, commit = cells[:5]
        if version in versions:
            die(f"wiki/versions.md contains duplicate version {version}")
        if not re.fullmatch(r"[0-9a-f]{40}", strip_ticks(commit)):
            die(f"wiki/versions.md: v{version} pinned commit is not a full 40-character sha")
        versions[version] = {
            "version": version,
            "status": status,
            "wiki_home": wiki_home,
            "branch": strip_ticks(branch),
            "commit": strip_ticks(commit),
            "coverage": cells[5] if len(cells) > 5 else "",
        }
    if not versions:
        die("wiki/versions.md has no supported versions")
    return versions


def wiki_markdown_files() -> list[Path]:
    if not WIKI_ROOT.exists():
        return []
    return sorted(path for path in WIKI_ROOT.rglob("*.md") if path.is_file())


def wiki_slug(path: Path) -> str:
    rel = path.relative_to(WIKI_ROOT)
    return rel.with_suffix("").as_posix()


def parse_front_matter(text: str) -> tuple[dict[str, object], str, bool]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, "", False

    end = None
    for index, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            end = index
            break
    if end is None:
        return {}, "", False

    raw = "\n".join(lines[1:end])
    data: dict[str, object] = {}
    current_map_key: str | None = None

    for line in raw.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue

        top = re.match(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$", line)
        if top:
            key, value = top.groups()
            if value == "":
                data[key] = {}
                current_map_key = key
            else:
                data[key] = value.strip().strip("'\"")
                current_map_key = None
            continue

        nested = re.match(r"^\s+([^:]+):\s*(.*)$", line)
        if nested and current_map_key and isinstance(data.get(current_map_key), dict):
            key, value = nested.groups()
            data[current_map_key][key.strip()] = value.strip().strip("'\"")  # type: ignore[index]

    return data, raw, True


LINK_RE = re.compile(r"(?<!!)\[\[([^\]\n]+)\]\]")
MD_LINK_RE = re.compile(
    r"(?<!!)\[([^\]\n]+)\]\([ \t]*(<[^<>\n]+>|[^\s()<>]+)"
    r"(?:[ \t]+(?:\"[^\"\n]*\"|'[^'\n]*'))?[ \t]*\)"
)
RAW_SOURCE_REF_RE = re.compile(r"(?:(?:\.\./)+)?raw/postgres-\d+/[^\s<>\])]+")
LINE_FRAGMENT_RE = re.compile(r"L([0-9]+)(?:-L([0-9]+))?")
_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")


def _mask(text: str) -> str:
    """Hide syntax without joining lines or emptying a link label."""
    return re.sub(r"[^\r\n]", " ", text)


def _strip_fenced_code(text: str) -> str:
    """Mask backtick/tilde fences, respecting their character and length."""
    fence = ""
    lines: list[str] = []
    for line in text.splitlines(keepends=True):
        match = _FENCE_RE.match(line)
        if fence:
            lines.append(_mask(line))
            if (match and match[1][0] == fence[0]
                    and len(match[1]) >= len(fence) and not match[2].strip()):
                fence = ""
        elif match and not (match[1][0] == "`" and "`" in match[2]):
            fence = match[1]
            lines.append(_mask(line))
        else:
            lines.append(line)
    return "".join(lines)


def _strip_markdown_code(text: str) -> str:
    """Mask code, preserving code-formatted labels as nonempty link labels."""
    text = _strip_fenced_code(text)
    ticks = list(re.finditer(r"`+", text))
    # Match a delimiter only to the next run of exactly the same length.
    following: dict[int, int] = {}
    next_tick: dict[int, int] = {}
    for index in range(len(ticks) - 1, -1, -1):
        size = len(ticks[index][0])
        if size in next_tick:
            following[index] = next_tick[size]
        next_tick[size] = index
    chunks: list[str] = []
    position = 0
    index = 0
    while index < len(ticks):
        end_index = following.get(index)
        if end_index is None:
            index += 1
            continue
        start, end = ticks[index].start(), ticks[end_index].end()
        chunks.extend((text[position:start], _mask(text[start:end])))
        position = end
        index = end_index + 1
    chunks.append(text[position:])
    return "".join(chunks)


def markdown_url(match: re.Match[str]) -> str:
    url = match.group(2).strip()
    return url[1:-1] if url.startswith("<") and url.endswith(">") else url


def is_raw_url(url: str) -> bool:
    if re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", url) or url.startswith("//"):
        return False
    path = url.split("#", 1)[0].split("?", 1)[0]
    return bool(re.search(r"(^|/)raw/postgres-[0-9]+/", path))


def raw_target(url: str, page_path: Path | None = None) -> str:
    path = url.split("#", 1)[0].split("?", 1)[0]
    # Retain compatibility with the old repo-relative citation URLs.
    if path.startswith("raw/"):
        resolved = (REPO_ROOT / path).resolve()
    elif page_path is not None:
        resolved = (page_path.parent / path).resolve()
    else:
        return path
    try:
        return resolved.relative_to(REPO_ROOT).as_posix()
    except ValueError:
        return path


def extract_obsidian_links(text: str) -> list[str]:
    # Strip fenced code blocks and inline code spans so we don't flag
    # example citations written in documentation prose.
    text = _strip_markdown_code(text)
    links: list[str] = []
    for match in LINK_RE.finditer(text):
        target = match.group(1).split("|", 1)[0].strip()
        target = target.split("#", 1)[0].strip()
        target = target.split("^", 1)[0].strip()
        if target.endswith(".md"):
            target = target[:-3]
        target = target.strip("/")
        if target:
            links.append(target)
    return links


def extract_markdown_raw_citations(text: str, page_path: Path | None = None) -> list[str]:
    """Return repo-relative paths from Markdown citations targeting raw/postgres-NN/.

    Markdown renderers such as VS Code resolve link URLs relative to the page
    being viewed, so managed pages may cite raw source with either repo-relative
    `raw/postgres-NN/...` URLs or page-relative `../.../raw/postgres-NN/...`
    URLs.  The linter normalizes both forms back to repo-relative paths before
    checking file existence and version matching.
    """
    text = _strip_markdown_code(text)
    targets: list[str] = []
    for match in MD_LINK_RE.finditer(text):
        url = markdown_url(match)
        if is_raw_url(url):
            targets.append(raw_target(url, page_path))
    return targets


def markdown_raw_citation_format_issues(
    text: str, page_path: Path | None = None,
    line_counts: dict[Path, int] | None = None,
) -> list[tuple[str, str]]:
    """Return format issues for Markdown links that target raw/postgres-NN/."""
    text = _strip_markdown_code(text)
    issues: list[tuple[str, str]] = []
    if line_counts is None:
        line_counts = {}
    for match in MD_LINK_RE.finditer(text):
        url = markdown_url(match)
        if not is_raw_url(url):
            continue
        fragment = url.partition("#")[2]
        lines = LINE_FRAGMENT_RE.fullmatch(fragment)
        if lines is None:
            issues.append((url, "line fragment must be #L<line> or #L<start>-L<end>"))
            continue
        start = int(lines[1])
        end = int(lines[2] or lines[1])
        if start < 1 or end < start:
            issues.append((url, "line range must be positive and ordered"))
            continue
        if page_path is not None:
            source = (REPO_ROOT / raw_target(url, page_path)).resolve()
            if not source.is_relative_to(REPO_ROOT / "raw") or not source.is_file():
                # The target check reports this separately.
                continue
            try:
                if source not in line_counts:
                    with source.open("rb") as handle:
                        line_counts[source] = sum(1 for _ in handle)
                if end > line_counts[source]:
                    issues.append((url, f"line range exceeds file length ({line_counts[source]} lines)"))
            except OSError as error:
                issues.append((url, f"cannot read citation target: {error}"))
    return issues


def raw_source_references_outside_links(text: str) -> list[str]:
    """Return raw/postgres-NN/ references not covered by a complete link."""
    text = _strip_markdown_code(text)
    linked_spans: list[tuple[int, int]] = []

    for match in MD_LINK_RE.finditer(text):
        url = markdown_url(match)
        if is_raw_url(url):
            linked_spans.append(match.span())

    for match in LINK_RE.finditer(text):
        target = match.group(1).split("|", 1)[0].strip()
        if target.startswith("raw/postgres-"):
            linked_spans.append(match.span())

    refs: list[str] = []
    for match in RAW_SOURCE_REF_RE.finditer(text):
        if any(start <= match.start() < end for start, end in linked_spans):
            continue
        refs.append(match.group(0).rstrip(".,;:"))
    return refs


def extract_markdown_wiki_links(text: str, page_path: Path) -> list[str]:
    """Return wiki slugs from page-relative Markdown links to wiki pages."""
    text = _strip_markdown_code(text)
    targets: list[str] = []
    for match in MD_LINK_RE.finditer(text):
        url = markdown_url(match)
        if not url or url.startswith("#"):
            continue
        if re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", url):
            continue

        path = url.split("#", 1)[0].split("?", 1)[0].strip()
        if not path or re.search(r"(^|/)raw/postgres-\d+/", path):
            continue

        resolved = (page_path.parent / path).resolve()
        try:
            rel = resolved.relative_to(WIKI_ROOT)
        except ValueError:
            continue
        if resolved.suffix != ".md":
            continue
        targets.append(rel.with_suffix("").as_posix())
    return targets


def section_text(text: str, heading: str) -> str:
    lines = text.splitlines()
    visible_lines = _strip_fenced_code(text).splitlines()
    start = None
    heading_line = f"## {heading}"
    for index, line in enumerate(visible_lines):
        if line.strip() == heading_line:
            start = index + 1
            break
    if start is None:
        return ""

    collected: list[str] = []
    for index in range(start, len(lines)):
        if visible_lines[index].startswith("## "):
            break
        collected.append(lines[index])
    return "\n".join(collected).strip()


COMMON_CONCEPT_DIR = "common-concepts"
COMMON_CONCEPT_TYPE = "common-concept"
MANAGED_VERSION_DIRS = ("questions", COMMON_CONCEPT_DIR)
CODEBASE_GUIDE_BASENAME = "codebase-navigation-guide"
CODEBASE_GUIDE_TYPE = "codebase-navigation-guide"
SOURCE_REQUIRED_TYPES = {"question", CODEBASE_GUIDE_TYPE, COMMON_CONCEPT_TYPE}
QUESTION_STYLE_TYPES = {"question", CODEBASE_GUIDE_TYPE}
QUESTION_SECTION_REQUIRED_TYPES = QUESTION_STYLE_TYPES
FRONT_MATTER_ORDER_TYPES = QUESTION_STYLE_TYPES | {COMMON_CONCEPT_TYPE}
TITLE_HINT_TYPES = QUESTION_STYLE_TYPES | {COMMON_CONCEPT_TYPE, "answer"}
UNVERIFIED_HINT = "(unverified)"
COMMON_CONCEPT_REQUIRED_SECTIONS = (
    "Contents",
    "Definition",
    "Why It Exists",
    "How It Works",
    "Where It Appears in Source",
    "Related Structures and Functions",
    "Interactions with Other Concepts",
    "Open Questions",
    "Source References",
    "Navigation",
)
ROOT_EXEMPT_SLUGS = {"index", "overview", "versions", "log"}
VERSION_ROOT_ALLOWED_BASENAMES = {"index", CODEBASE_GUIDE_BASENAME}


@dataclass
class Issue:
    severity: str
    path: str
    message: str


def rel(path: Path) -> str:
    return path.relative_to(REPO_ROOT).as_posix()


def is_version_local(slug: str) -> tuple[str | None, str | None]:
    parts = slug.split("/")
    if len(parts) == 2 and re.fullmatch(r"v\d+", parts[0]) and parts[1] == CODEBASE_GUIDE_BASENAME:
        return parts[0][1:], CODEBASE_GUIDE_TYPE
    if len(parts) >= 3 and re.fullmatch(r"v\d+", parts[0]) and parts[1] in MANAGED_VERSION_DIRS:
        return parts[0][1:], parts[1]
    return None, None


def requires_front_matter(slug: str) -> bool:
    version, _ = is_version_local(slug)
    return version is not None


def has_source_references(text: str, page_path: Path | None = None) -> bool:
    refs = section_text(text, "Source References")
    return bool(extract_markdown_raw_citations(refs, page_path))


def has_section(text: str, heading: str) -> bool:
    return any(line.strip() == f"## {heading}" for line in _strip_fenced_code(text).splitlines())


def page_title(text: str) -> str | None:
    """Return the first top-level Markdown title, which always precedes body content."""
    for line in _strip_fenced_code(text).splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return None


def git(checkout: Path, *args: str) -> tuple[int, str]:
    try:
        proc = subprocess.run(
            ["git", "-C", str(checkout), *args], capture_output=True, text=True,
        )
    except OSError as error:
        return 127, str(error)
    return proc.returncode, proc.stdout.strip()


def check_source_pin(version: str, commit: str) -> list[Issue]:
    """Verify the raw checkout is actually parked on the pinned commit.

    Citations carry line numbers that are only meaningful at the pinned commit,
    so a checkout sitting on a different commit silently invalidates every line
    range on that version's pages.
    """
    checkout = REPO_ROOT / f"raw/postgres-{version}"
    label = f"raw/postgres-{version}"
    if not checkout.is_dir():
        return [Issue("ERROR", label, f"missing source checkout for v{version}")]
    if not (checkout / ".git").exists():
        return [Issue("WARN", label, "source checkout is not a git repository; cannot verify pin")]
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        return [Issue("ERROR", "wiki/versions.md", f"v{version} pinned commit is not a full 40-character sha")]

    status, head = git(checkout, "rev-parse", "HEAD")
    if status == 127:
        return [Issue("WARN", label, "git is unavailable; cannot verify pin")]
    if status != 0:
        return [Issue("ERROR", label, "cannot read HEAD of source checkout")]

    issues: list[Issue] = []
    if git(checkout, "cat-file", "-e", f"{commit}^{{commit}}")[0] != 0:
        issues.append(Issue("ERROR", label, f"pinned commit {commit[:11]} is not present in the checkout"))
    elif head != commit:
        issues.append(Issue(
            "ERROR", label,
            f"checkout is on {head[:11]} but wiki/versions.md pins {commit[:11]}",
        ))

    if git(checkout, "status", "--porcelain")[1]:
        issues.append(Issue("WARN", label, "source checkout has uncommitted changes; evidence may not match the pin"))
    return issues


def resolve_link(target: str, current_slug: str, slugs: set[str]) -> str | None:
    target = target.strip("/")
    if target in slugs:
        return target

    current_parts = current_slug.split("/")[:-1]
    if current_parts:
        relative = "/".join([*current_parts, target])
        if relative in slugs:
            return relative

    if not target.endswith("/index"):
        index_target = f"{target}/index"
        if index_target in slugs:
            return index_target
    return None


def lint() -> tuple[list[Issue], list[Issue]]:
    errors: list[Issue] = []
    warnings: list[Issue] = []
    versions = load_versions()
    files = wiki_markdown_files()
    slugs = {wiki_slug(path) for path in files}
    inbound = {slug: 0 for slug in slugs}
    page_text = {path: path.read_text(encoding="utf-8") for path in files}
    line_counts: dict[Path, int] = {}

    for path, text in page_text.items():
        slug = wiki_slug(path)
        fm, _, has_fm = parse_front_matter(text)

        if requires_front_matter(slug) and not has_fm:
            errors.append(Issue("ERROR", rel(path), "missing required front matter"))

        parts = slug.split("/")
        if re.fullmatch(r"v[0-9]+", parts[0]) and parts[0][1:] not in versions:
            errors.append(Issue("ERROR", rel(path), f"version {parts[0]} is not registered in wiki/versions.md"))
        if (
            len(parts) == 2
            and re.fullmatch(r"v\d+", parts[0])
            and parts[1] not in VERSION_ROOT_ALLOWED_BASENAMES
        ):
            errors.append(Issue(
                "ERROR",
                rel(path),
                "version root may only contain index.md and codebase-navigation-guide.md",
            ))

        version, version_local_kind = is_version_local(slug)
        if version:
            expected = versions.get(version, {}).get("commit")
            if str(fm.get("version", "")) != version:
                errors.append(Issue("ERROR", rel(path), f"version-local page must declare version: {version}"))
            if expected and fm.get("pinned_commit") != expected:
                errors.append(Issue("ERROR", rel(path), f"pinned_commit does not match wiki/versions.md for v{version}"))

        page_type = str(fm.get("type", ""))
        if version_local_kind == "questions" and page_type != "question":
            errors.append(Issue("ERROR", rel(path), "question page must have type: question"))
        if page_type == "question" and version_local_kind != "questions":
            errors.append(Issue("ERROR", rel(path), "question page must live under wiki/vNN/questions/"))
        if version_local_kind == CODEBASE_GUIDE_TYPE and page_type != CODEBASE_GUIDE_TYPE:
            errors.append(Issue("ERROR", rel(path), f"codebase navigation guide must have type: {CODEBASE_GUIDE_TYPE}"))
        if page_type == CODEBASE_GUIDE_TYPE and version_local_kind != CODEBASE_GUIDE_TYPE:
            errors.append(Issue("ERROR", rel(path), "codebase navigation guide must live at wiki/vNN/codebase-navigation-guide.md"))

        if version_local_kind == COMMON_CONCEPT_DIR and page_type != COMMON_CONCEPT_TYPE:
            errors.append(Issue("ERROR", rel(path), f"common concept page must have type: {COMMON_CONCEPT_TYPE}"))
        if page_type == COMMON_CONCEPT_TYPE and version_local_kind != COMMON_CONCEPT_DIR:
            errors.append(Issue("ERROR", rel(path), f"common concept page must live under wiki/vNN/{COMMON_CONCEPT_DIR}/"))

        # A missing or misspelled type must not disable the path's other checks.
        page_type = {
            "questions": "question",
            COMMON_CONCEPT_DIR: COMMON_CONCEPT_TYPE,
            CODEBASE_GUIDE_TYPE: CODEBASE_GUIDE_TYPE,
        }.get(version_local_kind, page_type)

        if page_type in SOURCE_REQUIRED_TYPES and not has_source_references(text, path):
            errors.append(Issue("ERROR", rel(path), "missing ## Source References entries"))

        if page_type == COMMON_CONCEPT_TYPE:
            for heading in COMMON_CONCEPT_REQUIRED_SECTIONS:
                if not has_section(text, heading):
                    errors.append(Issue("ERROR", rel(path), f"common concept page missing ## {heading} section"))
            if not section_text(text, "Definition"):
                errors.append(Issue("ERROR", rel(path), "missing non-empty ## Definition section"))

        if page_type in QUESTION_SECTION_REQUIRED_TYPES:
            if not section_text(text, "Question"):
                errors.append(Issue("ERROR", rel(path), "missing non-empty ## Question section"))
            if not section_text(text, "Answer"):
                errors.append(Issue("ERROR", rel(path), "missing non-empty ## Answer section"))

        # Verification field checks
        if requires_front_matter(slug):
            all_keys = ['type', 'version', 'pinned_commit', 'verified', 'verified_by_agent']
            for key in all_keys:
                if key not in fm:
                    errors.append(Issue("ERROR", rel(path), f"missing required front matter field: {key}"))
            verified = fm.get("verified")
            if verified is not None and verified not in ("true", "false"):
                errors.append(Issue("ERROR", rel(path), "verified must be 'true' or 'false'"))

            vba = fm.get("verified_by_agent")
            if vba is not None and vba != 'not yet':
                if not re.fullmatch(r"[a-zA-Z0-9_-]+ [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", str(vba)):
                    errors.append(Issue("ERROR", rel(path), "verified_by_agent invalid format: <model> YYYY-MM-DDTHH:MM:SSZ"))
                else:
                    try:
                        datetime.strptime(str(vba).split(" ", 1)[1], "%Y-%m-%dT%H:%M:%SZ")
                    except ValueError:
                        errors.append(Issue("ERROR", rel(path), "verified_by_agent has an invalid UTC date or time"))

            if page_type in FRONT_MATTER_ORDER_TYPES:
                present_expected = [k for k in all_keys if k in fm]
                if list(fm.keys()) != present_expected:
                    warnings.append(Issue("WARN", rel(path), f"front matter keys not in order: {list(fm.keys())} (expected {all_keys})"))

            if page_type in TITLE_HINT_TYPES:
                title = page_title(text)
                if title is None:
                    errors.append(Issue("ERROR", rel(path), "missing top-level # title"))
                elif verified == "true" and UNVERIFIED_HINT in title:
                    errors.append(Issue("ERROR", rel(path), f"verified page title must not contain {UNVERIFIED_HINT}"))
                elif verified != "true" and not title.endswith(UNVERIFIED_HINT):
                    errors.append(Issue("ERROR", rel(path), f"unverified page title must end with {UNVERIFIED_HINT}"))

        for target in extract_obsidian_links(text):
            if target.startswith("raw/"):
                errors.append(Issue("ERROR", rel(path), f"raw source citations must use Markdown links: [[{target}]]"))
                if not (REPO_ROOT / target).exists():
                    errors.append(Issue("ERROR", rel(path), f"broken wiki link [[{target}]]"))
                continue
            resolved = resolve_link(target, slug, slugs)
            if not resolved:
                errors.append(Issue("ERROR", rel(path), f"broken wiki link [[{target}]]"))
            else:
                inbound[resolved] = inbound.get(resolved, 0) + 1
            errors.append(Issue(
                "ERROR", rel(path),
                f"wiki page links must use Markdown links for VS Code: [[{target}]]",
            ))

        for target in extract_markdown_wiki_links(text, path):
            if target not in slugs:
                errors.append(Issue("ERROR", rel(path), f"broken Markdown wiki link ({target})"))
            else:
                inbound[target] = inbound.get(target, 0) + 1

        for target in extract_markdown_raw_citations(text, path):
            source = (REPO_ROOT / target).resolve()
            if not source.is_relative_to(REPO_ROOT / "raw") or not source.is_file():
                errors.append(Issue("ERROR", rel(path), f"broken Markdown citation ({target}): target must be a file inside raw/"))
                continue
            if version:
                cited_match = re.match(r"raw/postgres-(\d+)/", target)
                if cited_match and cited_match.group(1) != version:
                    errors.append(Issue(
                        "ERROR", rel(path),
                        f"Markdown citation targets wrong version: {target}",
                    ))

        if page_type in SOURCE_REQUIRED_TYPES:
            for target, reason in markdown_raw_citation_format_issues(text, path, line_counts):
                errors.append(Issue(
                    "ERROR",
                    rel(path),
                    f"malformed Markdown citation ({target}): {reason}",
                ))

            for target in raw_source_references_outside_links(text):
                errors.append(Issue(
                    "ERROR",
                    rel(path),
                    f"raw source reference must be a complete Markdown citation: {target}",
                ))

    for slug, count in inbound.items():
        if count > 0:
            continue
        if slug in ROOT_EXEMPT_SLUGS or slug.endswith("/index"):
            continue
        warnings.append(Issue("WARN", f"wiki/{slug}.md", "orphan page has no inbound wiki links"))

    for version, info in versions.items():
        for issue in check_source_pin(version, info.get("commit", "")):
            (errors if issue.severity == "ERROR" else warnings).append(issue)

        guide = WIKI_ROOT / f"v{version}" / f"{CODEBASE_GUIDE_BASENAME}.md"
        if not guide.exists():
            errors.append(Issue("ERROR", rel(guide), "missing mandatory codebase navigation guide"))

        landing = WIKI_ROOT / f"v{version}" / "index.md"
        if not landing.exists():
            errors.append(Issue("ERROR", rel(landing), "missing version landing page"))
            continue
        landing_text = landing.read_text(encoding="utf-8")
        landing_slug = wiki_slug(landing)
        landing_targets = set(extract_markdown_wiki_links(landing_text, landing))
        for target in extract_obsidian_links(landing_text):
            resolved = resolve_link(target, landing_slug, slugs)
            if resolved:
                landing_targets.add(resolved)
        for path in files:
            slug = wiki_slug(path)
            page_version, _ = is_version_local(slug)
            if page_version == version and slug not in landing_targets:
                warnings.append(Issue("WARN", rel(landing), f"version landing page does not link {slug}"))

    return errors, warnings


def write_cache(errors: list[Issue], warnings: list[Issue]) -> None:
    cache_dir = REPO_ROOT / ".wiki-runtime" / "cache" / "wiki_lint"
    cache_dir.mkdir(parents=True, exist_ok=True)
    cache_path = cache_dir / "last-run.txt"
    with cache_path.open("w", encoding="utf-8") as handle:
        handle.write(f"errors: {len(errors)}\n")
        handle.write(f"warnings: {len(warnings)}\n")
        for issue in [*errors, *warnings]:
            handle.write(f"{issue.severity} {issue.path}: {issue.message}\n")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--warnings-as-errors", action="store_true", help="return a failing status for warnings too")
    args = parser.parse_args(argv)

    append_tool_log("wiki_lint", sys.argv[1:])
    errors, warnings = lint()
    write_cache(errors, warnings)

    print(f"wiki_lint: {len(errors)} error(s), {len(warnings)} warning(s)")
    for issue in [*errors, *warnings]:
        print(f"{issue.severity} {issue.path}: {issue.message}")

    if errors or (args.warnings_as_errors and warnings):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
